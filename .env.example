# Optional local LLM/OCR configuration.
# The static MVP can run without this file.
# Do not commit real API keys.

LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0
LLM_SEED=20260713
LLM_TIMEOUT_MS=90000

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Optional local proxy for browser CORS or customer-owned model gateway.
# Example: http://127.0.0.1:8787
LOCAL_LLM_PROXY_BASE_URL=http://127.0.0.1:8787

# OCR is a separate capability. OCR recognizes text; LLM explains process and errors.
OCR_PROVIDER=manual
OCR_BASE_URL=http://127.0.0.1:8790
OCR_API_KEY=
