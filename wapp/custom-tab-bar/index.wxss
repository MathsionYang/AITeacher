.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 166rpx;
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  display: flex;
  align-items: flex-start;
  padding-top: 16rpx;
  padding-bottom: 68rpx;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.tab-icon {
  font-size: 44rpx;
  color: #94a3b8;
  line-height: 1;
}

.tab-label {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 600;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-label {
  color: #0d9488;
}
