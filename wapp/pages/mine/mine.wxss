.profile-header { padding: 100rpx 40rpx 48rpx; display: flex; align-items: center; gap: 32rpx; }
.profile-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.2); border: 6rpx solid rgba(255,255,255,0.3); display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: #ffffff; font-weight: 700; }
.profile-info { display: flex; flex-direction: column; }
.pi-name { font-size: 40rpx; font-weight: 700; color: #ffffff; }
.pi-role { font-size: 26rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; display: flex; align-items: center; gap: 12rpx; }
.verify-badge { background: rgba(255,255,255,0.2); padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; }
.profile-scope-bar { margin: 24rpx 32rpx 0; background: #ffffff; border-radius: 24rpx; padding: 28rpx 32rpx; box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: space-between; }
.psb-left { display: flex; align-items: center; gap: 20rpx; min-width: 0; flex: 1; }
.psb-icon { width: 72rpx; height: 72rpx; border-radius: 20rpx; background: #f0fdfa; color: #0d9488; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.psb-text { display: flex; flex-direction: column; min-width: 0; }
.psb-name { font-size: 28rpx; font-weight: 600; color: #0f172a; }
.psb-value { font-size: 24rpx; color: #94a3b8; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.psb-arrow { color: #cbd5e1; font-size: 28rpx; }
.model-status-card { margin: 24rpx 32rpx; background: linear-gradient(135deg, #f0fdfa, #ccfbf1); border: 2rpx solid #99f6e4; border-radius: 28rpx; padding: 32rpx; display: flex; align-items: center; gap: 24rpx; }
.msc-icon { width: 80rpx; height: 80rpx; border-radius: 20rpx; background: #ffffff; color: #0d9488; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.msc-info { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.msc-name { font-size: 28rpx; font-weight: 700; color: #115e59; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.msc-mode { font-size: 24rpx; color: #0d9488; margin-top: 4rpx; }
.msc-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.msc-dot.online { background: #22c55e; box-shadow: 0 0 16rpx #22c55e; }
.msc-dot.offline { background: #ef4444; }
.profile-section-label { font-size: 26rpx; font-weight: 700; color: #64748b; padding: 0 32rpx; margin-top: 32rpx; margin-bottom: 16rpx; text-transform: uppercase; letter-spacing: 2rpx; }
.profile-menu { margin: 0 32rpx; background: #ffffff; border-radius: 28rpx; overflow: hidden; box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05); }
.profile-menu-item { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f1f5f9; }
.profile-menu-item:last-child { border-bottom: none; }
.pmi-icon { width: 64rpx; height: 64rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex-shrink: 0; font-weight: 700; }
.pmi-icon.teal { background: #f0fdfa; color: #0d9488; }
.pmi-icon.amber { background: #fffbeb; color: #d97706; }
.pmi-icon.blue { background: #eff6ff; color: #2563eb; }
.pmi-icon.green { background: #f0fdf4; color: #16a34a; }
.pmi-icon.slate { background: #f1f5f9; color: #475569; }
.pmi-text { flex: 1; font-size: 28rpx; font-weight: 600; color: #0f172a; }
.pmi-value { font-size: 26rpx; color: #94a3b8; }
.pmi-arrow { color: #cbd5e1; font-size: 28rpx; }
.model-summary-value { max-width: 300rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-form { padding: 8rpx 32rpx 32rpx; margin-top: 16rpx; }
.cloud-row { padding-top: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.form-help { display: block; font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; line-height: 1.5; }
.form-note { margin-top: 24rpx; padding: 20rpx; border-radius: 18rpx; background: #f0fdfa; color: #0f766e; font-size: 24rpx; line-height: 1.6; }
.form-row { padding-top: 24rpx; }
.form-label { display: block; font-size: 24rpx; font-weight: 600; color: #64748b; margin-bottom: 10rpx; }
.form-input { height: 80rpx; padding: 0 20rpx; border-radius: 18rpx; background: #f8fafc; border: 1rpx solid #e2e8f0; color: #0f172a; font-size: 26rpx; }
.form-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.logout-btn { margin: 48rpx 32rpx; background: #ffffff; border-radius: 24rpx; padding: 28rpx 0; text-align: center; box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05); }
.logout-text { font-size: 30rpx; font-weight: 600; color: #ef4444; }
