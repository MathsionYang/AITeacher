.login-page {
  min-height: 100vh;
  padding: 72rpx 36rpx 48rpx;
  background: linear-gradient(160deg, #0f766e 0%, #14b8a6 46%, #f8fafc 46%, #f8fafc 100%);
}

.brand-card {
  color: #ffffff;
  padding: 24rpx 8rpx 56rpx;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  font-size: 30rpx;
  font-weight: 900;
}

.brand-cn {
  margin-top: 28rpx;
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.brand-en {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 700;
  opacity: 0.9;
}

.brand-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  opacity: 0.82;
}

.login-card {
  padding: 40rpx 32rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 70rpx rgba(15, 23, 42, 0.16);
}

.login-title {
  font-size: 42rpx;
  font-weight: 900;
  color: #0f172a;
}

.login-subtitle {
  margin-top: 8rpx;
  margin-bottom: 32rpx;
  color: #64748b;
  font-size: 24rpx;
}

.field {
  margin-top: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #334155;
  font-size: 24rpx;
  font-weight: 800;
}

.input {
  height: 92rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 28rpx;
}

.remember {
  min-height: 64rpx;
  margin: 24rpx 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #64748b;
  font-size: 24rpx;
}

.login-btn {
  margin-top: 8rpx;
}

.demo-tip {
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #f0fdfa;
  color: #0f766e;
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
