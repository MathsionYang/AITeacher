.home-header {
  padding: 80rpx 40rpx 56rpx;
  position: relative;
  overflow: hidden;
}
.home-header::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}
.home-header::before {
  content: "";
  position: absolute;
  right: 40rpx;
  bottom: -40rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.home-greeting {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}
.home-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 700;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}
.home-greeting-text { display: flex; flex-direction: column; }
.home-greeting-text .hello { font-size: 26rpx; color: rgba(255, 255, 255, 0.8); }
.home-greeting-text .name { font-size: 36rpx; font-weight: 700; color: #ffffff; }
.home-scope-card {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.scope-info { display: flex; align-items: center; gap: 16rpx; }
.scope-badge {
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}
.scope-change { color: rgba(255, 255, 255, 0.7); font-size: 24rpx; }
.quick-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-top: -48rpx;
  position: relative;
  z-index: 2;
}
.quick-action {
  flex: 1;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 12rpx -2rpx rgba(0,0,0,0.08), 0 4rpx 8rpx -4rpx rgba(0,0,0,0.04);
}
.quick-action:active { transform: scale(0.95); }
.qa-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin: 0 auto 16rpx;
}
.qa-icon.teal { background: #f0fdfa; color: #0d9488; }
.qa-icon.amber { background: #fffbeb; color: #d97706; }
.qa-icon.blue { background: #eff6ff; color: #2563eb; }
.qa-title { display: block; font-size: 26rpx; font-weight: 700; color: #0f172a; }
.qa-sub { display: block; font-size: 20rpx; color: #94a3b8; margin-top: 4rpx; }
.home-section { padding: 0 32rpx; margin-top: 32rpx; margin-bottom: 32rpx; }
.stats-row { display: flex; gap: 16rpx; }
.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
  position: relative;
  overflow: hidden;
}
.stat-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
}
.stat-1::before { background: #2dd4bf; }
.stat-2::before { background: #fbbf24; }
.stat-3::before { background: #3b82f6; }
.stat-num { display: block; font-size: 48rpx; font-weight: 800; color: #0f172a; line-height: 1.1; }
.stat-label { display: block; font-size: 22rpx; color: #64748b; margin-top: 4rpx; }
.unit-summary-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}
.unit-summary-title { font-size: 30rpx; font-weight: 700; color: #0f172a; }
.unit-summary-text { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: #64748b; }
.mini-tags { margin-top: 20rpx; }
.activity-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}
.activity-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.activity-item:last-child { border-bottom: none; }
.activity-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.activity-icon.courseware { background: #f0fdfa; color: #0d9488; }
.activity-icon.practice { background: #eff6ff; color: #2563eb; }
.activity-icon.schedule { background: #fffbeb; color: #d97706; }
.activity-info { flex: 1; min-width: 0; }
.a-title { display: block; font-size: 28rpx; font-weight: 600; color: #0f172a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.a-meta { display: block; font-size: 24rpx; color: #94a3b8; margin-top: 4rpx; }
.activity-arrow { color: #cbd5e1; font-size: 28rpx; }
